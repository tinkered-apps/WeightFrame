{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weightframe",
  "compatibility_date": "2026-09-01",
  // Static site only: no Worker script, no bindings, no stored user data.
  "assets": {
    "directory": "./public",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "weightframe.tinkered.app", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  // Worker request logs off. The zone's security analytics still show sampled visitor IPs.
  "observability": { "enabled": false }
}
